# ==========================================
# TeacherPromptBuilder — .gitignore
# ==========================================


# ------------------------------------------
# 1. PyCharm / JetBrains
# ------------------------------------------

.idea/
*.iml
*.ipr
*.iws


# ------------------------------------------
# 2. Python — кэш и временные файлы
# ------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/


# ------------------------------------------
# 3. Виртуальные окружения Python
# ------------------------------------------

.venv/
venv/
env/
ENV/
virtualenv/


# ------------------------------------------
# 4. Flask
# ------------------------------------------

instance/
.webassets-cache/

# Локальные базы данных
*.db
*.sqlite
*.sqlite3


# ------------------------------------------
# 5. JavaScript / Node.js
# ------------------------------------------

node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Сборки фронтенда
.vite/
.next/
.nuxt/
coverage/


# ------------------------------------------
# 6. Секретные данные и переменные окружения
# ------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json


# ------------------------------------------
# 7. Логи
# ------------------------------------------

*.log
logs/
log/


# ------------------------------------------
# 8. Тестирование и отчёты
# ------------------------------------------

.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test-results/


# ------------------------------------------
# 9. Системные файлы
# ------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.Trash-*
.nfs*


# ------------------------------------------
# 10. Резервные копии редакторов
# ------------------------------------------

*.swp
*.swo
*.bak
*.tmp
*.temp
*.orig


# ==========================================
# Конец .gitignore
# ==========================================